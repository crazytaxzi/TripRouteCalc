{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "paths": {
      "@trip-route-calc/foundation": ["packages/foundation/src/index.ts"],
      "@trip-route-calc/foundation/*": ["packages/foundation/src/*.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/prisma.config.ts",
    "vitest.config.ts"
  ]
}
