{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@trip-route-calc/foundation": ["packages/foundation/src/index.ts"],
      "@trip-route-calc/foundation/*": ["packages/foundation/src/*.ts"],
      "@trip-route-calc/persistence": ["packages/persistence/src/index.ts"],
      "@trip-route-calc/persistence/*": ["packages/persistence/src/*.ts"],
      "@trip-route-calc/routing": ["packages/routing/src/index.ts"],
      "@trip-route-calc/routing/*": ["packages/routing/src/*.ts"],
      "@trip-route-calc/compliance": ["packages/compliance/src/index.ts"],
      "@trip-route-calc/compliance/*": ["packages/compliance/src/*.ts"],
      "@trip-route-calc/api": ["packages/api/src/index.ts"],
      "@trip-route-calc/api/*": ["packages/api/src/*.ts"]
    },
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/test/**/*.ts",
    "packages/web/e2e/**/*.ts",
    "packages/*/prisma.config.ts",
    "packages/*/vite.config.ts",
    "packages/*/playwright.config.ts",
    "vitest.config.ts"
  ]
}
